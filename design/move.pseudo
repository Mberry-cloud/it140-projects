# Project One Move-Between-Rooms Pseudocode - Mariah Berry
#Graded checkpoint: Module Five Project One

START move_between_rooms(current_room, rooms)
  #Information needed: player's current_room, rooms dictionary, and player's movement command
  SET command = ""

  #Repeat movement loop until player enters 'exit' or reaches the villain room
  WHILE command != "exit" AND current_room != "Emerald VIP Vault"
    OUTPUT "You are currently in: " + current_room
    OUTPUT "Available exits: " + exits in rooms[current_room]

    #Prompt for and recieve the player's movement command
      OUTPUT "Enter a direction (North, South, East, West) or 'exit':"
      INPUT command

    #Validate whether the requested movement is possible from current_room
    IF command is a valid direction in rooms[current_room] THEN
      #UPDATE current_room and output the new location
      SET current_room = rooms[current_room][command]
      OUTPUT "You moved to: " + current_room
    ELSE
      #Output an invalid direction message is not possible
      OUTPUT "You can't go that way! Please choose a valid direction."
    END IF
  END WHILE
  RETURN current_room
END move_between_rooms

