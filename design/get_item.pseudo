# Project One Get-Item Pseudocode - Mariah Berry
# Graded checkpoint: Module Five Project One

START get_item(current_room, rooms, inventory)
    # Information needed: player's current_room, room dictionary, and player's inventory
    # Prompt for and receive the player's get-item command
    OUTPUT "Enter 'get [item name]' to pick up an item:"
    INPUT command

    #Validate whether the requested item is available in the current room
    IF item is already in inventory THEN
        OUTPUT "You already have that item in your inventory!"
    ELSE
        IF item is in rooms[current_room] THEN
            # Update inventory, remove item from room, and output confirmation
            ADD item to inventory
            REMOVE item from rooms[current_room]
            OUTPUT item + "has been added to your inventory."
        ELSE
            # Output an invalid item message when the item is not in the room
            OUTPUT "There is no such item in this room!"
        END IF
    END IF

    # Display updated inventory and return to the main gameplay loop
    OUTPUT "Current Inventory: " + inventory
    RETURN inventory
END get_item

    # TODO 4: Describe what happens when the item request is valid.
    # Include the inventory update and player output.

    # TODO 5: Describe what happens when the item request is invalid.
    # Include the output the player should receive.

    # TODO 6: Show how the process returns to or continues the larger gameplay
    # loop after the command is handled.

END get_item


